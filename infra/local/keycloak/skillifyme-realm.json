{
  "realm": "skillifyme",
  "displayName": "SkillifyMe Portal (local dev)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@skillifyme.local",
    "fromDisplayName": "SkillifyMe (local)"
  },
  "roles": {
    "realm": [
      { "name": "super_admin", "description": "Platform operator: manages all organizations" },
      { "name": "org_admin", "description": "Administers one organization (college / training partner)" },
      { "name": "instructor", "description": "Creates courses, labs and assessments; reviews submissions" },
      { "name": "student", "description": "Learner" }
    ]
  },
  "clients": [
    {
      "clientId": "skillifyme-web",
      "name": "SkillifyMe Web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "skillifyme-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "skillifyme-api",
      "name": "SkillifyMe API (resource server)",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "superadmin@skillifyme.local",
      "email": "superadmin@skillifyme.local",
      "firstName": "Super",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Local-Dev-Only-1", "temporary": false }],
      "realmRoles": ["super_admin"]
    },
    {
      "username": "orgadmin@skillifyme.local",
      "email": "orgadmin@skillifyme.local",
      "firstName": "Org",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Local-Dev-Only-1", "temporary": false }],
      "realmRoles": ["org_admin"]
    },
    {
      "username": "instructor@skillifyme.local",
      "email": "instructor@skillifyme.local",
      "firstName": "Ira",
      "lastName": "Instructor",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Local-Dev-Only-1", "temporary": false }],
      "realmRoles": ["instructor"]
    },
    {
      "username": "student@skillifyme.local",
      "email": "student@skillifyme.local",
      "firstName": "Sam",
      "lastName": "Student",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Local-Dev-Only-1", "temporary": false }],
      "realmRoles": ["student"]
    }
  ]
}
