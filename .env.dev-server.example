# SkillifyMe Portal — dev/demo SERVER settings: exactly the keys that change from .env.example.
#
# This is a single-VM dev/demo environment (docker-compose.yml + docker-compose.prod.yml behind
# Caddy), NOT the production topology in docs/architecture.md. Runbook: infra/dev-vm/README.md.
#
# Build the server's .env as: .env.example, then every key below appended (later keys win), then
# replace each placeholder:
#   <DOMAIN>      your domain; the hostnames become dev.<DOMAIN>, auth.dev.<DOMAIN>, ...
#   <SECRET>      a NEW random value per key (e.g. `openssl rand -base64 32`), kept in the secret
#                 store. Never reuse one, never commit one.
#   <OPS_EMAIL>   Let's Encrypt account / expiry notices
#   <ADMIN_CIDR>  network allowed to open the Keycloak admin console, e.g. 198.51.100.7/32
#   <REGISTRY>/<GIT_SHA>  the CI-built runtime images to run
#   <MAILPIT_USER>, <BCRYPT_HASH>  Mailpit basic auth; make the hash with
#                 `docker run --rm caddy:2.10-alpine caddy hash-password`, then write every `$` in
#                 it as `$$` (docker compose would otherwise expand it)
# No real value belongs in this file.

ENVIRONMENT=staging
LOG_JSON=true

# ---------------------------------------------------------------- Hostnames (DNS A records -> VM)
WEB_HOST=dev.<DOMAIN>
AUTH_HOST=auth.dev.<DOMAIN>
FILES_HOST=files.dev.<DOMAIN>
MAIL_HOST=mail.dev.<DOMAIN>
ACME_EMAIL=<OPS_EMAIL>
ADMIN_ALLOW_CIDR=<ADMIN_CIDR>

# Every externally visible URL follows from the hostnames.
WEB_ORIGIN=https://${WEB_HOST}
KEYCLOAK_PUBLIC_URL=https://${AUTH_HOST}
S3_PUBLIC_ENDPOINT_URL=https://${FILES_HOST}
# Not reachable from outside on a server; containers use the redpanda service name.
KAFKA_EXTERNAL_HOST=redpanda

# ---------------------------------------------------------------- Images (built by CI)
API_IMAGE=<REGISTRY>/skillifyme-api:<GIT_SHA>
WEB_IMAGE=<REGISTRY>/skillifyme-web:<GIT_SHA>

# ---------------------------------------------------------------- Secrets (one new value each)
POSTGRES_PASSWORD=<SECRET>
APP_DB_PASSWORD=<SECRET>
RELAY_DB_PASSWORD=<SECRET>
KEYCLOAK_DB_PASSWORD=<SECRET>
MINIO_ROOT_PASSWORD=<SECRET>
KEYCLOAK_ADMIN_PASSWORD=<SECRET>
KC_WEB_CLIENT_SECRET=<SECRET>
KC_ADMIN_CLIENT_SECRET=<SECRET>
SESSION_SECRET=<SECRET>
REVALIDATE_SECRET=<SECRET>
MAILPIT_BASIC_AUTH_USER=<MAILPIT_USER>
MAILPIT_BASIC_AUTH_HASH=<BCRYPT_HASH>

# ---------------------------------------------------------------- Keycloak realm
# docker-compose.prod.yml also forces these two, whatever .env says.
KEYCLOAK_DEV_CLIENTS=false
KEYCLOAK_BRUTE_FORCE=true
KC_TEST_CLIENT_SECRET=
KEYCLOAK_DISPLAY_NAME=SkillifyMe Portal
# Only the web app's tokens; the password-grant test client doesn't exist on a server.
OIDC_ALLOWED_CLIENTS=["skillifyme-web"]

# ---------------------------------------------------------------- Mail
# Mailpit (MAIL_HOST) catches every email by default. For real delivery, point these at an SMTP
# relay instead (SMTP_USER/SMTP_PASSWORD, SMTP_STARTTLS=true).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@dev.<DOMAIN>
SMTP_FROM_NAME=SkillifyMe

# ---------------------------------------------------------------- Seeds and limits
# No dev users with a shared password on a server. Demo logins come from `make seed-demo`.
SEED_DEV_USERS=false
DEV_USER_PASSWORD=
AUTH_RATE_LIMIT_PER_MINUTE=20
REDIS_MAXMEMORY=512mb
