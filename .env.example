# SkillifyMe Portal — local development configuration.
# `make dev` copies this to .env on first run. Values here are LOCAL-ONLY placeholders;
# real environments get their secrets from the secret manager, never from files in git.
#
# Every externally visible URL is set here (WEB_ORIGIN, KEYCLOAK_PUBLIC_URL, S3_PUBLIC_ENDPOINT_URL)
# and nothing else hardcodes a host. A server changes only .env values: .env.dev-server.example
# lists exactly which keys change. `${NAME}` references other keys of this file (docker compose,
# the API's settings loader and make all expand them).

ENVIRONMENT=local
LOG_LEVEL=INFO
# true = JSON logs (as in production); false = human-readable console logs
LOG_JSON=false

# ---------------------------------------------------------------- PostgreSQL
# Owner/superuser: used by docker and Alembic migrations only.
POSTGRES_USER=skillify
POSTGRES_PASSWORD=local-dev-owner-pw
POSTGRES_DB=skillify
POSTGRES_PORT=5432
# Password for the non-owner runtime role `skillify_app` (RLS applies to it).
APP_DB_PASSWORD=local-dev-app-pw
# Password for `skillify_relay`, the role the outbox relay uses (reads outbox events only).
RELAY_DB_PASSWORD=local-dev-relay-pw

# Used when running the API/tests on the host. docker-compose builds its own in-network URLs.
DATABASE_URL=postgresql+asyncpg://skillify_app:local-dev-app-pw@localhost:5432/skillify
MIGRATION_DATABASE_URL=postgresql+asyncpg://skillify:local-dev-owner-pw@localhost:5432/skillify
RELAY_DATABASE_URL=postgresql+asyncpg://skillify_relay:local-dev-relay-pw@localhost:5432/skillify

# ---------------------------------------------------------------- Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- S3 (MinIO)
MINIO_ROOT_USER=skillify
MINIO_ROOT_PASSWORD=local-dev-minio-pw
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=skillifyme-local
# Browser-reachable S3 endpoint used in presigned upload/download URLs.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# Credentials the API uses for S3 (the MinIO root user locally).
S3_ACCESS_KEY_ID=skillify
S3_SECRET_ACCESS_KEY=local-dev-minio-pw

# ---------------------------------------------------------------- Kafka (Redpanda)
KAFKA_PORT=19092
# Hostname Redpanda advertises to clients outside Docker (host-run API, tests).
KAFKA_EXTERNAL_HOST=localhost
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
REDPANDA_CONSOLE_PORT=8082

# ---------------------------------------------------------------- Keycloak (OIDC)
# Port Keycloak listens on, both on your machine and inside the Docker network. Change it if the
# port is already taken (e.g. 8180); the URLs below follow it.
KEYCLOAK_PORT=8080
# Browser-facing Keycloak URL. Keycloak pins its token issuer to it (KC_HOSTNAME), so the issuer
# is <KEYCLOAK_PUBLIC_URL>/realms/<realm> however Keycloak is reached.
KEYCLOAK_PUBLIC_URL=http://localhost:${KEYCLOAK_PORT}
# Where processes on your machine (host-run API, tests, `make dev-web-host`) reach Keycloak for
# JWKS and the admin API. Containers use http://keycloak:<KEYCLOAK_PORT> (set in compose).
KEYCLOAK_INTERNAL_URL=http://localhost:${KEYCLOAK_PORT}
KEYCLOAK_REALM=skillifyme
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-dev-keycloak-pw
# The realm is rendered from infra/keycloak/realm.template.json at startup (keycloak-realm) and
# re-applied to an existing realm by keycloak-sync. Client secrets are local-only placeholders.
KC_WEB_CLIENT_SECRET=local-dev-web-client-secret
KC_ADMIN_CLIENT_SECRET=local-dev-admin-client-secret
KC_TEST_CLIENT_SECRET=local-dev-test-client-secret
# true adds the `skillifyme-test` client (password logins for automated tests). Never on a server.
KEYCLOAK_DEV_CLIENTS=true
# Brute-force login protection. Off locally so test runs can't lock the shared dev users out;
# docker-compose.prod.yml forces it on.
KEYCLOAK_BRUTE_FORCE=false
KEYCLOAK_DISPLAY_NAME="SkillifyMe (local)"
OIDC_WEB_CLIENT_ID=skillifyme-web
OIDC_AUDIENCE=skillifyme-api
# Clients (the token's `azp`) whose access tokens the API accepts.
# `skillifyme-test` exists only with KEYCLOAK_DEV_CLIENTS=true: never list it on a server.
OIDC_ALLOWED_CLIENTS=["skillifyme-web","skillifyme-test"]
# Optional Google sign-in. Leave empty to disable. The Google OAuth client's redirect URI must be
# <KEYCLOAK_PUBLIC_URL>/realms/<KEYCLOAK_REALM>/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Servers only: Keycloak's own Postgres login and database (`make migrate` creates both). Locally
# Keycloak keeps its data in its built-in dev store, so leave these unset.
# KEYCLOAK_DB_USER=keycloak
# KEYCLOAK_DB_NAME=keycloak
# KEYCLOAK_DB_PASSWORD=

# ---------------------------------------------------------------- Mail
# Keycloak sends invitation and password emails through this SMTP server. Locally that is Mailpit
# (inside the Docker network, so the host is `mailpit`); on a server, a real SMTP relay.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@skillifyme.local
SMTP_FROM_NAME="SkillifyMe (local)"
# Leave SMTP_USER empty for no authentication (Mailpit). SMTP_STARTTLS / SMTP_SSL: true or false.
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false

# ---------------------------------------------------------------- OpenTelemetry
# Leave empty to disable tracing. Example: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------- Ports for app containers
API_PORT=8000
WEB_PORT=3000

# ---------------------------------------------------------------- Web (Next.js)
# Server-side base URL the web app uses to reach the API (browser calls go through /backend).
API_INTERNAL_URL=http://localhost:8000
# Browser origin of the web app (Keycloak redirects here after invitation emails).
WEB_ORIGIN=http://localhost:3000
# Encrypts the web app's session cookies (32+ characters). Local-only placeholder; use a
# random value from the secret manager in real environments.
SESSION_SECRET=local-dev-session-secret-change-me-0123456789
# Shared by the API/worker and the web app: protects POST /api/revalidate, which regenerates the
# static public catalog after a publish. Use a long random value outside local development.
REVALIDATE_SECRET=local-dev-revalidate-secret-change-me-0123456789
# Web app: "off" makes the public catalog read the API fresh on every request (local development;
# compose and `make dev-web-host` set it). Leave it unset in production: the catalog then uses
# Next's tagged data cache, refreshed on publish and every 5 minutes.
# CATALOG_DATA_CACHE=off
# Sign-in attempts allowed per client per minute (the web app's /auth routes). Clients are
# identified by X-Forwarded-For from the edge proxy; locally there is none, so every browser
# shares one bucket, hence the high dev value (production: 20).
AUTH_RATE_LIMIT_PER_MINUTE=300

# ---------------------------------------------------------------- Files (PDFs, notes images)
# Browser uploads use presigned POSTs that storage restricts to one key, one content type and this
# size. Downloads are signed GET URLs that expire after FILE_DOWNLOAD_TTL_SECONDS.
PDF_UPLOAD_MAX_BYTES=26214400
IMAGE_UPLOAD_MAX_BYTES=5242880
# Students' assignment uploads (PDF, PNG or JPEG).
SUBMISSION_UPLOAD_MAX_BYTES=10485760
FILE_UPLOAD_TTL_SECONDS=600
FILE_DOWNLOAD_TTL_SECONDS=300

# ---------------------------------------------------------------- Video
# local = MinIO uploads + MP4 playback (dev and CI). bunny = Bunny Stream (set every BUNNY_* key).
VIDEO_PROVIDER=local
VIDEO_UPLOAD_MAX_BYTES=2147483648
VIDEO_UPLOAD_TTL_SECONDS=3600
VIDEO_PLAYBACK_TTL_SECONDS=300
BUNNY_API_URL=https://video.bunnycdn.com
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
# The library's CDN hostname, e.g. vz-12345678-abc.b-cdn.net
BUNNY_CDN_HOSTNAME=
# CDN "token authentication" key of the library's pull zone.
BUNNY_TOKEN_KEY=
# Random secret embedded in the webhook URL: <api>/api/v1/webhooks/video/bunny/<secret>
BUNNY_WEBHOOK_SECRET=
# The web player's heartbeat interval (keep in sync with apps/web/src/features/video/heartbeat.ts).
# One heartbeat earns at most 1.5x this in watch time, and never more than 1.5x the real time
# since the previous heartbeat.
HEARTBEAT_INTERVAL_SECONDS=15
# Video heartbeats are buffered in Redis and flushed to Postgres on this interval.
PROGRESS_FLUSH_INTERVAL_SECONDS=30

# ---------------------------------------------------------------- Dev seed (`make seed`)
# true creates the 12 dev users (README) in Keycloak, all with DEV_USER_PASSWORD, plus their orgs
# and batches. Tests and Playwright sign in as them. Never true on a server.
SEED_DEV_USERS=true
DEV_USER_PASSWORD=Local-Dev-Only-1

# ---------------------------------------------------------------- Demo seed (`make seed-demo`)
# Where the generated demo passwords are written (mode 0600; gitignored). Compose mounts ./.secrets
# and sets this to /secrets/demo-credentials.txt, so locally the file is ./.secrets/demo-credentials.txt.
# DEMO_CREDENTIALS_FILE=.secrets/demo-credentials.txt
