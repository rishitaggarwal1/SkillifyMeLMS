# SkillifyMe Portal — local development configuration.
# `make dev` copies this to .env on first run. Values here are LOCAL-ONLY placeholders;
# real environments get their secrets from the secret manager, never from files in git.

ENVIRONMENT=local
LOG_LEVEL=INFO
# true = JSON logs (as in production); false = human-readable console logs
LOG_JSON=false

# ---------------------------------------------------------------- PostgreSQL
# Owner/superuser: used by docker and Alembic migrations only.
POSTGRES_USER=skillify
POSTGRES_PASSWORD=local-dev-owner-pw
POSTGRES_DB=skillify
POSTGRES_PORT=5432
# Password for the non-owner runtime role `skillify_app` (RLS applies to it).
APP_DB_PASSWORD=local-dev-app-pw
# Password for `skillify_relay`, the role the outbox relay uses (reads outbox events only).
RELAY_DB_PASSWORD=local-dev-relay-pw

# Used when running the API/tests on the host. docker-compose builds its own in-network URLs.
DATABASE_URL=postgresql+asyncpg://skillify_app:local-dev-app-pw@localhost:5432/skillify
MIGRATION_DATABASE_URL=postgresql+asyncpg://skillify:local-dev-owner-pw@localhost:5432/skillify
RELAY_DATABASE_URL=postgresql+asyncpg://skillify_relay:local-dev-relay-pw@localhost:5432/skillify

# ---------------------------------------------------------------- Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- S3 (MinIO)
MINIO_ROOT_USER=skillify
MINIO_ROOT_PASSWORD=local-dev-minio-pw
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=skillifyme-local
# Browser-reachable S3 endpoint used in presigned upload/download URLs.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# Credentials the API uses for S3 (the MinIO root user locally).
S3_ACCESS_KEY_ID=skillify
S3_SECRET_ACCESS_KEY=local-dev-minio-pw

# ---------------------------------------------------------------- Kafka (Redpanda)
KAFKA_PORT=19092
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
REDPANDA_CONSOLE_PORT=8082

# ---------------------------------------------------------------- Keycloak (OIDC)
# Port Keycloak listens on, both on your machine and inside the Docker network. Change it if the
# port is already taken (e.g. 8180). Everything else is derived from it: the token issuer
# (http://localhost:<port>/realms/<realm>), the API's JWKS URL, the web app's OIDC settings, and
# the dev realm's redirect URIs.
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=skillifyme
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-dev-keycloak-pw
# Client secrets for the dev realm, injected into the realm import. Local-only placeholders.
KC_WEB_CLIENT_SECRET=local-dev-web-client-secret
KC_ADMIN_CLIENT_SECRET=local-dev-admin-client-secret
KC_TEST_CLIENT_SECRET=local-dev-test-client-secret
OIDC_WEB_CLIENT_ID=skillifyme-web
OIDC_AUDIENCE=skillifyme-api
# Clients (the token's `azp`) whose access tokens the API accepts.
# `skillifyme-test` exists only in the dev realm: it allows password logins for automated tests.
OIDC_ALLOWED_CLIENTS=["skillifyme-web","skillifyme-test"]
# Optional Google sign-in for the dev realm. Leave empty to disable. The Google OAuth client's
# redirect URI must be http://localhost:<KEYCLOAK_PORT>/realms/skillifyme/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- Mail (Mailpit)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025

# ---------------------------------------------------------------- OpenTelemetry
# Leave empty to disable tracing. Example: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------- Ports for app containers
API_PORT=8000
WEB_PORT=3000

# ---------------------------------------------------------------- Web (Next.js)
# Server-side base URL the web app uses to reach the API (browser calls go through /backend).
API_INTERNAL_URL=http://localhost:8000
# Browser origin of the web app (Keycloak redirects here after invitation emails).
WEB_ORIGIN=http://localhost:3000
# Encrypts the web app's session cookies (32+ characters). Local-only placeholder; use a
# random value from the secret manager in real environments.
SESSION_SECRET=local-dev-session-secret-change-me-0123456789
# Sign-in attempts allowed per client per minute (the web app's /auth routes). Clients are
# identified by X-Forwarded-For from the edge proxy; locally there is none, so every browser
# shares one bucket, hence the high dev value (production: 20).
AUTH_RATE_LIMIT_PER_MINUTE=300

# ---------------------------------------------------------------- Files (PDFs, notes images)
# Browser uploads use presigned POSTs that storage restricts to one key, one content type and this
# size. Downloads are signed GET URLs that expire after FILE_DOWNLOAD_TTL_SECONDS.
PDF_UPLOAD_MAX_BYTES=26214400
IMAGE_UPLOAD_MAX_BYTES=5242880
FILE_UPLOAD_TTL_SECONDS=600
FILE_DOWNLOAD_TTL_SECONDS=300

# ---------------------------------------------------------------- Video
# local = MinIO uploads + MP4 playback (dev and CI). bunny = Bunny Stream (set every BUNNY_* key).
VIDEO_PROVIDER=local
VIDEO_UPLOAD_MAX_BYTES=2147483648
VIDEO_UPLOAD_TTL_SECONDS=3600
VIDEO_PLAYBACK_TTL_SECONDS=300
BUNNY_API_URL=https://video.bunnycdn.com
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
# The library's CDN hostname, e.g. vz-12345678-abc.b-cdn.net
BUNNY_CDN_HOSTNAME=
# CDN "token authentication" key of the library's pull zone.
BUNNY_TOKEN_KEY=
# Random secret embedded in the webhook URL: <api>/api/v1/webhooks/video/bunny/<secret>
BUNNY_WEBHOOK_SECRET=
# The web player's heartbeat interval (keep in sync with apps/web/src/features/video/heartbeat.ts).
# One heartbeat earns at most 1.5x this in watch time, and never more than 1.5x the real time
# since the previous heartbeat.
HEARTBEAT_INTERVAL_SECONDS=15
# Video heartbeats are buffered in Redis and flushed to Postgres on this interval.
PROGRESS_FLUSH_INTERVAL_SECONDS=30
